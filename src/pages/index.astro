---
import { getEmDashCollection, getSiteSettings } from "emdash"
import Base from "../layouts/Base.astro"
import { resolveStarterSiteIdentity } from "../utils/site-identity"
import JsonLd from "../components/JsonLd.astro"
import { SectionHeader } from "../components/SectionHeader"
import { FeaturedAvisoCard } from "../components/FeaturedAvisoCard"
import { ProgramCard } from "../components/ProgramCard"
import NewsCard from "../components/NewsCard/NewsCard.astro"
import { Button } from "../components/Button"
import { Image } from "astro:assets"
import { Image as CmsImage } from "emdash/ui"
import talleres from "../assets/talleres.webp"
import beneficios from "../assets/beneficios.webp"
import type { ImageMetadata } from "astro"

const campusModules = import.meta.glob<{ default: ImageMetadata }>("../assets/campus/*.{webp,jpg,jpeg,png}", { eager: true })
const campusImages = Object.values(campusModules).map(m => m.default)
function shuffle<T>(arr: T[]): T[] {
  const a = [...arr]
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]]
  }
  return a
}
const galleryImages = shuffle(campusImages).slice(0, 7)

const [
  { entries: licenciaturas, cacheHint: ch1 },
  { entries: maestrias, cacheHint: ch2 },
  { entries: posts, cacheHint: ch3 },
  { entries: heroHighlights, cacheHint: ch4 },
  { entries: mediaItems, cacheHint: ch5 },
] = await Promise.all([
  getEmDashCollection("licenciaturas", { orderBy: { order: "asc" } }),
  getEmDashCollection("maestrias", {}),
  getEmDashCollection("posts", { orderBy: { published_at: "desc" } }),
  getEmDashCollection("aviso_destacado", { orderBy: { start_date: "desc" }, limit: 1 }),
  getEmDashCollection("galeria_multimedia", { orderBy: { order: "asc" } }),
])
Astro.cache.set(ch1)
Astro.cache.set(ch2)
Astro.cache.set(ch3)
Astro.cache.set(ch4)
Astro.cache.set(ch5)

function ytId(url: string | null | undefined): string | null {
  if (!url) return null
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&?/]+)/)
  return m?.[1] ?? null
}

const latestHighlight = heroHighlights[0]
const highlightDate = latestHighlight?.data?.start_date
  ? new Date(latestHighlight.data.start_date)
  : null
const highlightDay = highlightDate
  ? String(highlightDate.getUTCDate())
  : ""
const highlightMonthYear = highlightDate
  ? highlightDate.toLocaleDateString("es-MX", { month: "long", year: "numeric", timeZone: "UTC" })
  : ""

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings())

const featuredLic = licenciaturas.find(l => l.data.slug === 'mercadotecnia')
const restLics = licenciaturas.filter(l => l.data.slug !== 'mercadotecnia')
const orderedLics = featuredLic ? [featuredLic, ...restLics] : licenciaturas
---

<JsonLd schema={{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Centro Universitario Tlacaélel",
  "alternateName": "CUT",
  "url": "https://cut.com.mx",
  "description": "Institución de educación superior comprometida con la justicia social, el pensamiento crítico y la formación integral.",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "MX",
    "addressLocality": "México"
  },
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "RVOE",
    "recognizedBy": {
      "@type": "GovernmentOrganization",
      "name": "SEP"
    }
  }
}} />
<Base title={siteTitle} description={siteTagline}>

  <!-- Hero -->
  <div class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Ciclo Escolar 2026 · Inscripciones Abiertas</span>
          <h1 class="t-display-lg" style="margin: 1.5rem 0 1.75rem;">
            Liberar <em style="font-style:italic; color:var(--primary); font-weight:500;">Educando</em>,<br/>
            formar para<br/>transformar.
          </h1>
          <p class="t-body-lg hero-lede">
            Una educación integral comprometida con la justicia social, el pensamiento crítico y la inclusión.
          </p>
          <div class="hero-cta">
            <Button variant="primary" href="/convocatoria">CONVOCATORIA 2026</Button>
          </div>
        </div>
        <aside class="hero-aside">
          <div class="stat-row">
            <div class="stat">
              <a href="#programs" class="num">{licenciaturas.length}</a>
              <div class="lbl">Licenciaturas</div>
            </div>
            <div class="stat">
              <a href="#maestrias-section" class="num">{maestrias.length}</a>
              <div class="lbl">Maestrías</div>
            </div>
            <div class="stat">
              <a href="#about" class="num">15<sup>años</sup></a>
              <div class="lbl">De Trayectoria</div>
            </div>
          </div>
          {latestHighlight && (
            <FeaturedAvisoCard
              day={highlightDay}
              monthYear={highlightMonthYear}
              kicker={latestHighlight.data.kicker ?? "Aviso"}
              title={latestHighlight.data.title ?? ''}
              meta={latestHighlight.data.meta ?? ""}
              linkText={latestHighlight.data.cta_label}
              href={latestHighlight.data.cta_href}
            />
          )}
        </aside>
      </div>
    </div>
  </div>

  <!-- Misión -->
  <section class="section" id="about">
    <div class="container">
      <SectionHeader
        num="— 01"
        title="Nuestra misión."
        description="Una institución comprometida con la formación integral de profesionales."
      />
      <div class="mission-grid">
        <div>
          <blockquote class="pull-q">
            "Proporcionar una educación de calidad que promueva la justicia social, el pensamiento crítico y la inclusión, contribuyendo al desarrollo integral de individuos capaces de liderar en un mundo globalizado."
          </blockquote>
          <p class="t-body-md" style="margin-top:2rem;">
            El Centro Universitario Tlacaélel forma personas comprometidas con el desarrollo de su comunidad, brindando una educación integral para el mejoramiento continuo que favorezca a cada estudiante en su crecimiento personal y profesional.
          </p>
        </div>
        <div class="pillars">
          <div class="pillar">
            <div class="label">— Visión</div>
            <div>
              <h3>Excelencia con compromiso social.</h3>
              <p>Ser reconocidos como institución de excelencia en la formación de profesionales comprometidos con la transformación social mexicana.</p>
            </div>
          </div>
          <div class="pillar">
            <div class="label">— Valores</div>
            <div>
              <h3>Ética, innovación y cultura.</h3>
              <p>La integración del contenido académico con la ética profesional, la innovación pedagógica, el deporte y la actividad cultural.</p>
            </div>
          </div>
          <div class="pillar">
            <div class="label">— Modelo</div>
            <div>
              <h3>Formación integral y crítica.</h3>
              <p>Programas que abordan las necesidades del entorno laboral y fomentan la responsabilidad social y los derechos humanos.</p>
            </div>
          </div>
          <div class="pillar">
            <div class="label">— Identidad</div>
            <div>
              <h3>Tlacaélel — el Azteca entre los aztecas.</h3>
              <p>Honramos una tradición de pensamiento mexicano arraigada en el rigor, la disciplina y la responsabilidad colectiva.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Oferta educativa -->
  <section class="section section--low" id="programs">
    <div class="container">
      <SectionHeader
        num="— 02"
        title="Oferta educativa."
        description="Siete licenciaturas y posgrados, diseñados para las demandas del entorno profesional contemporáneo."
      />
      <div class="program-grid">
        {orderedLics.map((entry, i) => {
          const isFeatured = entry.data.slug === 'mercadotecnia'
          const displayIdx = isFeatured ? '— 01' : `— ${String(i + 1).padStart(2, '0')}`
          return isFeatured ? (
            <div class="prog--span2">
              <ProgramCard
                index={`${displayIdx} · Nuevo 2026`}
                title={entry.data.title}
                meta={`${entry.data.modality ?? 'Presencial'} · ${entry.data.duration ?? '9 sem.'}`}
                href={`/licenciaturas/${(entry as any).slug}`}
                variant="featured"
                />
                </div>
                ) : (
                <ProgramCard
                index={displayIdx}
                title={entry.data.title}
                meta="Licenciatura"
                href={`/licenciaturas/${(entry as any).slug}`}
                variant="default"
                />
                )
                })}      </div>
      <div class="programs-subsection" id="maestrias-section">
        <div class="programs-subsection-head">
          <div>
            <div class="t-mono">— Posgrados</div>
            <h3 class="t-headline-md" style="margin:0;">Maestrías y especialidades.</h3>
          </div>
          <p class="t-label-md">Modalidad modular y mixta · Desarrollo semestral</p>
        </div>
        <div class="masters-grid" style="margin-top:0;">
          {maestrias.map((entry, i) => (
            <ProgramCard
              index={`M.${String(i + 1).padStart(2, '0')}`}
              title={entry.data.title}
              meta={`Maestría${entry.data.duration ? ` · ${entry.data.duration}` : ''}`}
              href={`/maestrias/${entry.data.slug}`}
              variant="master"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Noticias -->
  <section class="section" id="news">
    <div class="container">
      <SectionHeader num="— 03" title="Noticias y avisos." description="Convocatorias, resultados y eventos del Centro Universitario." />
      {posts.length > 0 ? (
        <div class="news-grid">
          {posts.slice(0, 3).map(post => (
            <NewsCard
              date={post.data.fecha_publicacion
                ? new Date(post.data.fecha_publicacion).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' })
                : 'Reciente'}
              title={post.data.title}
              excerpt={post.data.excerpt}
              href={`/posts/${post.data.slug}`}
              image={post.data.featured_image}
              imageRatio="4:3"
            />
          ))}
        </div>
      ) : (
        <p class="t-body-md">No hay noticias recientes.</p>
      )}
    </div>
  </section>

  <!-- Galería multimedia -->
  {mediaItems.length > 0 && (
    <section class="section section--low" id="galeria-multimedia">
      <div class="container">
        <SectionHeader num="— 04" title="Galería multimedia del CUT." description="Imágenes y video del Centro Universitario Tlacaélel." />
        <div class="carousel" id="media-carousel">
          <div class="carousel__track" id="carousel-track">
            {mediaItems.map((item) => {
              const hasVideo = !!item.data.video_url
              const hasYT = !!item.data.youtube_url
              const isVideo = hasVideo || hasYT
              const type = hasVideo ? 'video' : hasYT ? 'youtube' : 'image'
              const id = hasYT ? ytId(item.data.youtube_url) : null
              const thumbSrc = item.data.image?.src ?? (id ? `https://img.youtube.com/vi/${id}/hqdefault.jpg` : null)
              const mediaSrc = hasVideo ? item.data.video_url : hasYT ? item.data.youtube_url : item.data.image?.src
              return (
                <div class="carousel__slide">
                  <button class="carousel__open" data-type={type} data-media={mediaSrc} aria-label="Ver en pantalla completa">
                    {item.data.image
                      ? <CmsImage image={item.data.image} alt={item.data.caption ?? item.data.title ?? ''} />
                      : thumbSrc
                        ? <img src={thumbSrc} alt={item.data.caption ?? item.data.title ?? ''} loading="lazy" />
                        : <div class="carousel__no-thumb">▶</div>
                    }
                    {isVideo
                      ? <span class="carousel__play" aria-hidden="true"><span class="carousel__play-icon">▶</span></span>
                      : <span class="carousel__zoom" aria-hidden="true">⤢</span>
                    }
                  </button>
                </div>
              )
            })}
          </div>
          {mediaItems.length > 1 && (
            <>
              <button class="carousel__arrow carousel__arrow--prev" id="carousel-prev" aria-label="Anterior">‹</button>
              <button class="carousel__arrow carousel__arrow--next" id="carousel-next" aria-label="Siguiente">›</button>
            </>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Vida universitaria -->
  <section class="section section--low">
    <div class="container">
      <SectionHeader num="— 05" title="Vida universitaria." description="Campus, actividades culturales, deportivas y vida cotidiana en CUT." />
      <div class="gallery-grid">
        {galleryImages.map((img, i) => (
          <div class={`gallery-item g${i + 1}`}>
            <Image src={img} alt="Vida universitaria CUT" />
            <button class="gallery-zoom" aria-label="Ver imagen completa"></button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Más allá del aula -->
  <section class="section">
    <div class="container">
      <SectionHeader num="— 06" title="Más allá del aula." description="La formación integral exige cuerpo y cultura. Talleres abiertos a estudiantes de todas las carreras." />
    </div>
    <div class="culture-split">
      <div class="culture-cell">
        <Image src={talleres} alt="Talleres culturales CUT" class="culture-cell-img" />
        <div>
          <span class="eyebrow">— Talleres Culturales y Deportivos</span>
          <h3>La cultura como herramienta crítica.</h3>
          <p class="t-body-md" style="margin-top:.85rem;">En el Centro Universitario Tlacaelel, valoramos la formación integral de nuestros estudiantes, y creemos firmemente que la educación va más allá de las aulas. Por ello, ofrecemos una amplia gama de talleres culturales y deportivos que fomentan el desarrollo físico, emocional y social de nuestros alumnos, ayudándolos a cultivar habilidades y valores que les serán útiles en todos los aspectos de su vida.</p>
        </div>
      </div>
      <div class="culture-cell culture-cell--dark">
        <Image src={beneficios} alt="Talleres deportivos CUT" class="culture-cell-img" />
        <div>
          <span class="eyebrow eyebrow--light">— Participación y Beneficios</span>
          <h3>Disciplina, equipo, comunidad.</h3>
          <p style="color:rgba(255,255,255,.7); font-size:1rem; margin-top:.85rem; line-height:1.6;">Todos nuestros talleres están abiertos a estudiantes de todas las carreras, sin importar su nivel de experiencia. Al participar en estas actividades, los alumnos tienen la oportunidad de descubrir nuevos intereses, desarrollar habilidades sociales y mantenerse activos, lo cual contribuye a su bienestar integral. Además, los talleres culturales y deportivos son una excelente oportunidad para desconectar del estrés académico y construir amistades duraderas.</p>
        </div>

      </div>
    </div>
  </section>


<script>
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('gallery-lightbox-img') as HTMLImageElement | null;
  const lightboxVideo = document.getElementById('gallery-lightbox-video');
  const closeBtn = document.getElementById('gallery-lightbox-close');

  const open = (type: 'image' | 'youtube' | 'video', src: string) => {
    if (!lightbox) return;
    lightbox.classList.remove('is-image', 'is-video');
    if (type === 'image') {
      if (lightboxImg) lightboxImg.src = src;
      lightbox.classList.add('is-image');
    } else {
      if (lightboxVideo) {
        const embedSrc = type === 'youtube'
          ? src.replace(/.*(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&?/]+).*/, 'https://www.youtube.com/embed/$1?autoplay=1')
          : src;
        lightboxVideo.innerHTML = type === 'youtube'
          ? `<iframe src="${embedSrc}" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture"></iframe>`
          : `<video src="${src}" controls autoplay></video>`;
      }
      lightbox.classList.add('is-video');
    }
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  };

  const dismiss = () => {
    lightbox?.classList.remove('is-open', 'is-image', 'is-video');
    if (lightboxVideo) lightboxVideo.innerHTML = '';
    document.body.style.overflow = '';
  };

  // gallery images
  document.querySelectorAll<HTMLButtonElement>('.gallery-zoom').forEach(btn => {
    btn.addEventListener('click', () => {
      const img = btn.closest('.gallery-item')?.querySelector('img');
      if (img) open('image', img.currentSrc || img.src);
    });
  });

  // carousel slides
  document.querySelectorAll<HTMLButtonElement>('.carousel__open').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = (btn.dataset.type ?? 'image') as 'image' | 'youtube' | 'video';
      const media = btn.dataset.media || btn.querySelector('img')?.src || '';
      if (media) open(type, media);
    });
  });

  closeBtn?.addEventListener('click', dismiss);
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) dismiss(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dismiss(); });

  // carousel arrows
  const track = document.getElementById('carousel-track');
  const slide = document.querySelector<HTMLElement>('.carousel__slide');
  const slideWidth = () => (slide?.offsetWidth ?? 0) + 16; // 16 = gap
  document.getElementById('carousel-prev')?.addEventListener('click', () => track?.scrollBy({ left: -slideWidth(), behavior: 'smooth' }));
  document.getElementById('carousel-next')?.addEventListener('click', () => track?.scrollBy({ left: slideWidth(), behavior: 'smooth' }));
</script>

<div class="gallery-lightbox" id="gallery-lightbox" aria-hidden="true">
  <button class="gallery-lightbox__close" id="gallery-lightbox-close" aria-label="Cerrar">✕</button>
  <div class="gallery-lightbox__img">
    <img id="gallery-lightbox-img" src="" alt="Vida universitaria CUT" />
  </div>
  <div class="gallery-lightbox__video" id="gallery-lightbox-video"></div>
</div>

</Base>

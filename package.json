{
  "name": "cut-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "bootstrap": "emdash init && emdash seed",
    "seed": "emdash seed seed/seed.json --database \"$(find .wrangler/state/v3/d1 -name '*.sqlite' ! -name 'metadata*' 2>/dev/null | head -1 || echo data.db)\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/react": "^7.1.8",
    "@emdash-cms/cloudflare": "^1.5.0",
    "astro": "^7.4.11",
    "emdash": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "resend-email": "file:./plugins/resend-email"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@chromatic-com/storybook": "^5.6.0",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "download"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
